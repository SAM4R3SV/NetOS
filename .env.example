NETOS_ENVIRONMENT=development
NETOS_DATABASE_PATH=data/netos.sqlite3
NETOS_LOG_LEVEL=INFO
NETOS_LOG_DIRECTORY=logs
NETOS_LOG_RETENTION_DAYS=30
NETOS_AUDIT_RETENTION_DAYS=30
NETOS_API_HOST=127.0.0.1
NETOS_API_PORT=8000
NETOS_API_RELOAD=false
NETOS_API_TITLE=NetOS API
NETOS_MONITORING_ENABLED=true
NETOS_MONITORING_INTERVAL_SECONDS=5
NETOS_NETWORK_DISCOVERY_ENABLED=true
